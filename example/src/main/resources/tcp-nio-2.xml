<!--
    TCP based stack, with flow control and message bundling. This is usually used when IP
    multicasting cannot be used in a network, e.g. because it is disabled (routers discard multicast).
    Note that TCP.bind_addr and TCPPING.initial_hosts should be set, possibly via system properties, e.g.
    -Djgroups.bind_addr=192.168.5.2 and -Djgroups.tcpping.initial_hosts=192.168.5.2[7800]
    author: Bela Ban
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="urn:org:jgroups"
        xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups.xsd urn:org:jgroups ">

    <TCP_NIO2 bind_port="7800"
              bind_addr="GLOBAL"
              port_range="0"
              receive_on_all_interfaces="false"
              external_addr="${HOST_ADDRESS}"
              external_port="${INFINISPAN_TCP_PORT}"
              thread_pool.min_threads="0"
              thread_pool.max_threads="200"
              thread_pool.keep_alive_time="30000"
                />
    <RED/>

    <dns.DNS_PING dns_address="${CONSUL_HOST}:${CONSUL_DNS_PORT}"
                  dns_query="${INFINISPAN_CLUSTER_NAME}.service.consul"
                  dns_record_type="SRV"
                  probe_transport_ports="false"
                  send_cache_on_join="false"
                    />

    <MERGE3 min_interval="3000" max_interval="30000"/>
    <!--TCPPING async_discovery="false" port_range="1"/-->
    <FD_SOCK sock_conn_timeout="5000"/>
    <FD_ALL3 timeout="3000" interval="1000"/>
    <VERIFY_SUSPECT2 timeout="1000"/>
    <BARRIER/>
    <pbcast.NAKACK2
            use_mcast_xmit="false"
            xmit_interval="200"
            xmit_table_num_rows="50"
            xmit_table_msgs_per_row="1024"
            xmit_table_max_compaction_time="30000"
            resend_last_seqno_max_times="10000"/>
    <UNICAST3
            conn_close_timeout="5000"
            xmit_interval="200"
            xmit_table_num_rows="50"
            xmit_table_msgs_per_row="1024"
            xmit_table_max_compaction_time="30000"
    />

    <pbcast.STABLE desired_avg_gossip="2000" max_bytes="1M"/>

    <pbcast.GMS
            print_local_addr="true"
            join_timeout="10000"
            max_join_attempts="3"
            max_leave_attempts="3"
            print_view_details="true"/>

    <UFC max_credits="2M" min_threshold="0.4"/>
    <MFC max_credits="2M" min_threshold="0.4"/>
    <FRAG4 frag_size="60K"/>
    <!--RSVP resend_interval="2000" timeout="10000"/-->
    <pbcast.STATE_TRANSFER/>

</config>